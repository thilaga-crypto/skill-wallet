# 1) Get a Gemini API key from Google AI Studio.
# 2) Copy this file to .env
# 3) Replace the placeholder below with your own key.
# IMPORTANT: Never share or upload your real .env file.

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Current stable model choices:
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Number of tries per model for temporary 503/429 errors
GEMINI_MAX_RETRIES=3

# true = if Gemini is unavailable, show a local backup plan instead of a red 503 error
OFFLINE_FALLBACK=true

FLASK_SECRET_KEY=change-this-local-secret
